{
  "name": "collabtron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:client && node --env-file-if-exists=.env --watch src/server/main.ts",
    "build:client": "esbuild src/client/main.ts --bundle --format=esm --outdir=dist/client",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
