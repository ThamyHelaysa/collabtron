# Copy to .env and fill with real values. Never commit .env.
# dev: plain HTTP, loopback only (the only mode so far).
MODE=dev
HOST=127.0.0.1
PORT=8080
# Local clone of the Eleventy site.
SITE_DIR=/path/to/site
# The site's posts directory: one folder per Post, each with index.md.
POSTS_DIR=/path/to/site/src/posts
